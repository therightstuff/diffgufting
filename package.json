{
  "name": "diffgusting",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop diff editor with layered Git changes and explicit external-change review",
  "repository": { "type": "git", "url": "https://github.com/therightstuff/diffgusting" },
  "funding": { "type": "individual", "url": "https://industrialcuriosity.com/shop" },
  "type": "module",
  "main": "src/desktop/main.mjs",
  "bin": { "diffgusting": "bin/diffgusting.mjs" },
  "scripts": {
    "build": "node scripts/build-app.mjs",
    "start": "node bin/diffgusting.mjs",
    "test": "node scripts/test-runner.mjs -- node --test tests/*.test.mjs",
    "test:desktop": "node scripts/test-runner.mjs -- node --test --test-concurrency=1 tests/desktop/*.test.mjs",
    "test:focused": "node scripts/test-runner.mjs -- node --test",
    "test:performance": "node scripts/test-runner.mjs -- node --test tests/performance.test.mjs",
    "test:stress": "node scripts/test-runner.mjs -- node --test tests/stress-profiles.test.mjs",
    "icons": "node scripts/export-icons.mjs",
    "package": "node scripts/package-app.mjs"
  },
  "engines": { "node": ">=24" },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "sharp": "0.35.4"
  }
}
